# Copy to .env. Never commit real API keys.
CHAT_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# To use several Gemini keys for fallback, set a comma-separated list instead:
# GEMINI_API_KEYS=key-one,key-two,key-three

# For Ollama, run `ollama pull qwen2.5:1.5b` before starting the app, then
# uncomment these settings. Keep the model name aligned with `ollama list`.
# CHAT_PROVIDER=openai-compatible
# LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_MODEL_NAME=qwen2.5:1.5b
# LOCAL_MODEL_API_KEY=

# NCERT retrieval (Python retrieval_service.py, default http://127.0.0.1:8000).
# Retrieval is fail-open: if the service is down, chat still works without evidence.
# NCERT_RETRIEVAL_URL=http://127.0.0.1:8000
# NCERT_RETRIEVAL_TOP_K=5
# NCERT_RETRIEVAL_TIMEOUT_MS=15000
# NCERT_RETRIEVAL_ENABLED=true
# Only sources scoring at/above this reranker value are shown (default 0:
# relevant hits score positive, junk scores negative). Raise to be stricter.
# NCERT_RETRIEVAL_MIN_SCORE=0
