# Copy to .env. Never commit real API keys.
CHAT_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# To use several Gemini keys for fallback, set a comma-separated list instead:
# GEMINI_API_KEYS=key-one,key-two,key-three

# For a local OpenAI-compatible server such as Ollama, change CHAT_PROVIDER
# and set a model name that is already installed and served by that server.
# CHAT_PROVIDER=openai-compatible
# LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_MODEL_NAME=llama3.2
# LOCAL_MODEL_API_KEY=
