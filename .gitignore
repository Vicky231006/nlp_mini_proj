# Dependencies and build output
node_modules/
dist/
dist-ssr/

# Local logs and editor files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Local environment variables and credentials
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Local account data (SQLite)
data/

# Operating-system and IDE files
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local
.playwright-mcp
.venv-retrieval/

# Python bytecode & caches
__pycache__/
*.pyc

# Turnitin / Turnitout reports and methodology documents
*turnitin*
*turnitout*
**/*turnitin*
**/*turnitout*

# PDFs and Office documents
*.pdf
**/*.pdf
*.docx
**/*.docx
*.doc
**/*.doc
*.tex
**/*.tex

# Images (PNG, JPG, JPEG, WebP)
*.png
**/*.png
*.jpg
**/*.jpg
*.jpeg
**/*.jpeg
*.webp
**/*.webp
!public/favicon.svg

# Temporary directories and runtime scratch files
tmp/
tmp/**
